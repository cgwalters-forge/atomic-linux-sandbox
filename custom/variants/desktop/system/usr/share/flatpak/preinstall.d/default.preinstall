# Installed from Flathub by atomic-linux-flatpak-preinstall.service at boot.
# A core set like Bluefin's, minus what the desktop already ships as RPMs
# (Nautilus, Text Editor, Software) and Bluefin's own picks.
[Flatpak Preinstall org.mozilla.firefox]
Branch=stable
CollectionID=org.flathub.Stable

[Flatpak Preinstall org.gnome.Calculator]
Branch=stable
CollectionID=org.flathub.Stable

